{
  "name": "ai-rulebook",
  "displayName": "AI Rulebook: AGENTS.md Rules for Coding Agents",
  "description": "Manage AGENTS.md rules (with a CLAUDE.md import) for AI coding agents in Cursor, Claude Code, GitHub Copilot, Cline, Windsurf, opencode, and Codex: toggle rules, switch agent modes, and run an on-request code review.",
  "version": "4.4.1",
  "author": {
    "name": "Ron Picard",
    "url": "https://wyvernsystems.com"
  },
  "publisher": "WyvernSystemsLLC",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/wyvernsystems/ai-rulebook-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/wyvernsystems/ai-rulebook-vscode-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wyvernsystems/ai-rulebook-vscode-extension.git"
  },
  "keywords": [
    "agents-md",
    "agents.md",
    "claude-md",
    "claude.md",
    "rules",
    "ai-rules",
    "agent-rules",
    "coding-rules",
    "cursor-rules",
    "vscode-rules",
    "copilot-instructions",
    "cline-rules",
    "windsurf-rules",
    "claude-code",
    "cursor",
    "github-copilot",
    "cline",
    "windsurf",
    "opencode",
    "codex",
    "vscode",
    "ai-agent",
    "coding-agent",
    "subagents",
    "guardrails",
    "code-review",
    "prompt-engineering",
    "rulebook",
    "ai"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.18.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiRules.installWorkspace",
        "title": "AI Rulebook: Install / update rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.enableCoreWorkspace",
        "title": "AI Rulebook: Enable all rules (workspace)",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.disableCoreWorkspace",
        "title": "AI Rulebook: Disable all rules (workspace)",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.enableRuleWorkspace",
        "title": "AI Rulebook: Enable one rule…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.disableRuleWorkspace",
        "title": "AI Rulebook: Disable one rule…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeWorkspace",
        "title": "AI Rulebook: Remove rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeLegacyFoldersWorkspace",
        "title": "AI Rulebook: Remove legacy per-tool rule folders…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.selectAgentMode",
        "title": "AI Rulebook: Select agent mode…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.enableSubagentMode",
        "title": "AI Rulebook: Enable token-efficient subagent mode",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.disableSubagentMode",
        "title": "AI Rulebook: Disable token-efficient subagent mode",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.enableParallelMode",
        "title": "AI Rulebook: Enable fast parallel agent mode",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.disableParallelMode",
        "title": "AI Rulebook: Disable fast parallel agent mode",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.showCoreStatus",
        "title": "AI Rulebook: Show rule pack status",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.refreshTree",
        "title": "AI Rulebook: Refresh sidebar",
        "category": "AI Rulebook",
        "icon": "$(refresh)"
      },
      {
        "command": "aiRules.revealRuleFile",
        "title": "AI Rulebook: Open rule file",
        "category": "AI Rulebook"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiRulesSidebar",
          "title": "AI Rulebook",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "aiRulesSidebar": [
        {
          "id": "aiRules.rulesTree",
          "name": "Rule Pack",
          "icon": "$(checklist)",
          "contextualTitle": "AI Rulebook"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aiRules.revealRuleFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aiRules.refreshTree",
          "when": "view == aiRules.rulesTree",
          "group": "navigation@9"
        },
        {
          "command": "aiRules.enableCoreWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "1_state@1"
        },
        {
          "command": "aiRules.disableCoreWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "1_state@2"
        },
        {
          "command": "aiRules.installWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "2_workspace@1"
        },
        {
          "command": "aiRules.removeWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "2_workspace@2"
        },
        {
          "command": "aiRules.removeLegacyFoldersWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "2_workspace@3"
        },
        {
          "command": "aiRules.selectAgentMode",
          "when": "view == aiRules.rulesTree",
          "group": "3_modes@1"
        },
        {
          "command": "aiRules.showCoreStatus",
          "when": "view == aiRules.rulesTree",
          "group": "4_inspect@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiRules.rulesTree",
        "contents": "Open a project folder to install and manage its AI rule pack.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "colors": [
      {
        "id": "aiRulebook.activeForeground",
        "description": "Foreground color for enabled rules.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#2EA043"
        }
      },
      {
        "id": "aiRulebook.inactiveForeground",
        "description": "Foreground color for disabled rules.",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#F85149"
        }
      }
    ],
    "configuration": {
      "title": "AI Rulebook",
      "properties": {
        "aiRules.autoInstallOnOpenWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "When opening a workspace that shows signs of AI-agent use (an AGENTS.md, CLAUDE.md, .cursor/, .clinerules/, .opencode/, .windsurf/, or .github/instructions/ entry, or a Cursor host / installed Cline extension) and has no AI Rulebook block in AGENTS.md yet, install the rule pack automatically. Existing text in AGENTS.md is never overwritten."
        },
        "aiRules.promptInstallOnUpdate": {
          "type": "boolean",
          "default": true,
          "description": "When the extension version changes, offer to refresh the AGENTS.md rule pack from the bundled copy."
        }
      }
    }
  },
  "scripts": {
    "sync-bundled": "npm run compile && node scripts/sync-bundled.mjs && node scripts/build-standalone.mjs",
    "verify:bundled": "node scripts/verify-bundled.mjs",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npm run verify:bundled && node --test tests/*.test.mjs",
    "test:coverage": "npm run compile && npm run verify:bundled && node --test --experimental-test-coverage tests/*.test.mjs",
    "vscode:prepublish": "npm run sync-bundled && npm run verify:bundled",
    "package": "vsce package",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^10.10.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0"
  }
}
